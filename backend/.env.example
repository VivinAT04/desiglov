# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/desiglov

# Frontend / CORS
FRONTEND_URL=http://localhost:5173

# Legacy/local JWT configuration
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Razorpay
# Use "test" during testing and "live" only for production.
RAZORPAY_MODE=test

# Razorpay API credentials.
# Never commit real keys or secrets.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Razorpay webhook signing secret.
# This is configured separately in the Razorpay webhook settings.
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# Extra safety switch.
# Keep false until production payment testing is complete.
RAZORPAY_LIVE_PAYMENTS_ENABLED=false
